{
  "name": "@blazity/cv-review-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "ash dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "ash:build": "ash build",
    "eval": "ash eval --all --skip-report"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.0-canary.47",
    "@blazity/ash-plugin-governance": "workspace:*",
    "@blazity/ash-plugin-memory": "workspace:*",
    "@blazity/ash-plugin-observability": "workspace:*",
    "@vercel/connect": "0.0.4-alpha.8",
    "experimental-ash": "0.16.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.6"
  }
}
