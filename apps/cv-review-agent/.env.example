# Model provider used by agent/agent.ts.
OPENAI_API_KEY=

# Vercel Connect Slack connector identifier.
# Use the exact UID/key copied from Vercel Connect, for example:
# - slack/cv-review-agent
# - scl_xxxxxxxxxxxxxxxxx
VERCEL_CONNECT_SLACK_CLIENT_UID=slack/cv-review-agent

# Optional comma-separated allowlists. Leave empty for local demos.
# Set these before using the agent in a real workspace.
ALLOWED_SLACK_TEAM_IDS=
ALLOWED_SLACK_CHANNEL_IDS=
