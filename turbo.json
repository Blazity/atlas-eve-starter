{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "eve:build": {
      "dependsOn": ["^build"],
      "outputs": [".eve/**"]
    },
    "eval": {
      "dependsOn": ["^build"],
      "outputs": [".eve/evals/**"],
      "cache": false
    }
  }
}
