{
  "name": "atlas-eve-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build": "turbo build",
    "eve:build": "turbo eve:build",
    "eval": "turbo eval",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,md}": "biome format --write --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@types/node": "24.13.2",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "turbo": "2.9.18",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
